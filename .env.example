NODE_ENV=development
FINGROW_BACKEND_HOST=127.0.0.1
FINGROW_BACKEND_PORT=4317
FINGROW_BACKEND_DATA_DIR=./data
FINGROW_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:3000,http://127.0.0.1:3000

# Leave these empty for the local SQLite database. Vercel uses Turso Cloud.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate independent random secrets for these values. Keep the real file private.
FINGROW_OTP_HASH_SECRET=replace-with-at-least-32-random-bytes
FINGROW_TOKEN_HASH_SECRET=replace-with-a-different-32-byte-secret

# SMTP is required for OTP registration and profile creation.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=FinGrow <no-reply@example.com>
